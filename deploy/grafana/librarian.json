{
  "uid": "librarian-slo",
  "title": "Librarian SLOs",
  "tags": [
    "librarian"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability, 30 days (SLO 99.5%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Share of requests that were not a 5xx. Counters reset on a deploy; increase() handles that. Needs 30 days of retention to be exact: Prometheus keeps 45.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "1 - (sum(increase(librarian_http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(librarian_http_requests_total[30d])), 1))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Error budget left, 30 days",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "1 means untouched, 0 means spent, negative means the SLO is missed.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "1 - ((sum(increase(librarian_http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(librarian_http_requests_total[30d])), 1)) / 0.005)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Search p95 (SLO < 500 ms)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Lesson search and the search_wiki tool, 5 minute window.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "librarian:search_p95_seconds:rate5m",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Chat first token p95 (SLO < 4 s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Request arrival to the first token event, 5 minute window.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "librarian:chat_first_token_p95_seconds:rate5m",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Requests by status code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "sum by (status) (rate(librarian_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "5xx ratio (budget 0.5%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "5m and 1h windows; the fast-burn alert fires at 14.4x the budget line on both.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "librarian:http_error_ratio:rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "librarian:http_error_ratio:rate1h",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "0.005",
          "legendFormat": "budget"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Search latency quantiles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(librarian_search_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(librarian_search_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(librarian_search_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Chat first token quantiles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(librarian_chat_first_token_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(librarian_chat_first_token_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(librarian_chat_first_token_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Slowest routes, p95",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "SSE streams count to the last byte, so the chat stream is long by design: read chat from the first-token panel.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(librarian_http_request_duration_seconds_bucket[15m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Chat streams by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "no_token is a stream that ended without an answer: a provider error or a refusal.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "sum by (outcome) (rate(librarian_chat_streams_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Readiness (per replica)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "1 when /readyz would answer 200.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "min(librarian_ready)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "State disk free",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "The disk holding var/ (indexes, logs, caches).",
      "gridPos": {
        "x": 6,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "min(librarian_state_disk_free_ratio)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Spend today vs global cap",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Empty when no global cap is set (LIBRARIAN_CHAT_DAILY_BUDGET_USD). Alert at 80%.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "max(librarian_chat_spend_usd{window=\"today\"}) / (max(librarian_chat_spend_cap_usd{scope=\"global_daily\"}) > 0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Chat spend, USD",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Estimated from the price table (librarian pricing check), not the provider invoice.",
      "gridPos": {
        "x": 18,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "max(librarian_chat_spend_usd{window=\"today\"})",
          "legendFormat": "today"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "max(librarian_chat_spend_usd{window=\"30d\"})",
          "legendFormat": "30 days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Public probe and certificate days left",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "From the blackbox probe through Caddy.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "probe_success{job=\"librarian-blackbox\"}",
          "legendFormat": "probe"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"librarian-blackbox\"} - time()) / 86400",
          "legendFormat": "cert days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Release",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "librarian-prometheus"
      },
      "description": "Deployed image release and content release.",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "librarian-prometheus"
          },
          "expr": "librarian_release_info",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
