# Librarian — environment variables
# Copy to .env and fill in what you need. Everything is optional unless noted.
# Loaded with python-dotenv by src/librarian/api/main.py, the MCP server, the librarian CLI and src/librarian/tools/codemap.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=           # chat agent (src/librarian/agent/loop.py), presenter, src/librarian/tools/cartographer/enrich.py and session_parser.py
# ANTHROPIC_MODEL=claude-sonnet-5-5 # chat agent model (src/librarian/agent/loop.py)
# EVAL_JUDGE_MODEL=claude-opus-5-5  # LLM judge in evals/run_eval.py

# --- Notion integration (librarian/ingest/ingest_notion.py) ---
NOTION_API_KEY=

# --- Linear integration (librarian/ingest/ingest_linear.py) ---
LINEAR_API_KEY=
LINEAR_PROJECT_ID=           # default project for ingest_linear (override with --project)

# --- PDF ingest (librarian/ingest/ingest_pdf.py) ---
# DROPBOX_PDF_PATH=~/Dropbox/research-pdfs

# --- Cron fetchers (src/librarian/tools/cartographer/cron.py): set to "true" to enable ---
# ARXIV_FETCH_ENABLED=false
# FEED_FETCH_ENABLED=false

# --- Paths ---
# WORKSPACE_ROOT=~/workspace        # sibling repos for src/librarian/tools/cartographer/session_parser.py (default: ~/workspace)
# SISYPHUS_DIR=../sisyphus          # drill attempt log read by librarian/courses/catalog.py
# WIKI_DIR=data/wiki                # retrieval and MCP server (librarian.retrieval)
# COURSES_DIR=data/courses          # MCP server
# WIKI_DB_PATH=.wiki_index.duckdb   # MCP server index

# --- Search and embeddings ---
# LIBRARIAN_EMBEDDING_MODEL=all-MiniLM-L6-v2   # librarian/retrieval/embeddings.py

# --- Code index (src/librarian/tools/codemap) ---
# CODEMAP_API_HOST=127.0.0.1        # src/librarian/tools/codemap/api.py
# CODEMAP_API_PORT=8100
# CODEMAP_API_URL=http://localhost:8100   # MCP codemap tools (src/librarian/mcp/codemap_tools.py)

# --- Backend ---
# LIBRARIAN_SKIP_WARMUP=1           # skip index warmup on startup (src/librarian/api/main.py)
# LIBRARIAN_DEV_WATCH=1             # watch data/wiki and push graph updates over /ws (`make api` sets it; per process, off in deployments)

# --- Presenter (src/librarian/tools/presenter, pydantic-settings; names are case-insensitive) ---
# VIZ_MODEL=claude-opus-4-8
# VIZ_AUDIENCE=engineering
# VIZ_OUTPUT_DIR=output/presenter
# IMAGE_PROVIDER=pollinations       # or "replicate"
# REPLICATE_API_TOKEN=              # only with IMAGE_PROVIDER=replicate

# --- Deployment (docker-compose.yml; see src/librarian/api/security.py) ---
# LIBRARIAN_API_TOKEN=              # bootstrap bearer token, acts as the owner; unset = open, also as the owner (local dev only)
# LIBRARIAN_OWNER_EMAIL=owner@localhost   # the admin the bootstrap token and open mode act as
# (other users sign in with an API key: `librarian users add <email>`, then `librarian keys create <email>`)
# LIBRARIAN_STATE_DIR=var           # one directory for the index, caches, logs and flashcard results
# DATABASE_URL=postgresql://user:pw@host:5432/db   # user state; unset = SQLite at var/librarian.sqlite3
# POSTGRES_PASSWORD=                # compose's postgres service (URL-safe characters)
# LIBRARIAN_CORS_ORIGINS=http://localhost:5173   # comma-separated
# LIBRARIAN_API_WORKERS=2           # uvicorn worker processes (`librarian api --workers N` overrides; compose default 2)
# LIBRARIAN_INDEX_AUTOBUILD=0       # API only opens the index; compose's indexer service builds it
# LIBRARIAN_CHAT_RATE_LIMIT=20      # chat requests per window, per worker process (0 = off)
# LIBRARIAN_CHAT_RATE_WINDOW_S=60
# LIBRARIAN_CHAT_DAILY_BUDGET_USD=5 # estimated daily chat spend cap for all users together (0 = off)
# LIBRARIAN_CHAT_USER_DAILY_BUDGET_USD=1   # the same cap per member; admins have only the global one (0 = off)
# (the spend estimate uses the price table in src/librarian/pricing.py, keyed by ANTHROPIC_MODEL;
#  a model missing from the table is refused at startup)
# LIBRARIAN_WEB_DIR=app/dist   # built UI the API serves at /
# SERVE_COURSE_SOURCES=false        # the compose file sets this

# --- Observability (src/librarian/observability.py; needs `uv sync --extra observability`) ---
# Everything below is off until set. No network calls and no OTel/Sentry import when unset.
# Traces: Langfuse Cloud over OTLP/HTTP (EU base shown; US is https://us.cloud.langfuse.com/api/public/otel).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of pk-lf-...:sk-lf-...>,x-langfuse-ingestion-version=4
# LIBRARIAN_EXPERIMENT=             # value of the `experiment` span attribute (empty by default)
# LIBRARIAN_TRACE_CONTENT=0         # 1 puts the query and answer text on agent.turn spans (off by default)
# Errors: Sentry.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# LIBRARIAN_RELEASE=                # on logs, spans and Sentry; default git short sha, else "dev". Docker: --build-arg LIBRARIAN_RELEASE=...
