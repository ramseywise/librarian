# Conversational voice (`make voice`). Everything below is optional: the defaults are local speech
# and no key but ANTHROPIC_API_KEY. Interviewing is always local, whatever is set here.
# VOICE_MODEL=                    # Default: the chat model (LIBRARIAN's anthropic model setting). A
#                                 # faster model may suit speech: every first-token millisecond is heard.
# VOICE_PORT=8200                 # VOICE_URL on the API side must match
# VOICE_URL=http://127.0.0.1:8200
# VOICE_ALLOWED_ORIGINS=          # Comma list. Default the Vite dev origins on port 5173.
# VOICE_MAX_TOKENS=1200
# VOICE_IDLE_TIMEOUT_S=300
# VOICE_MAX_DURATION_S=1800
# VOICE_MAX_TURNS=60
# VOICE_MAX_SESSION_TOKENS=60000
# VOICE_WHISPER_MODEL=tiny.en
# VOICE_KOKORO_VOICE=af_heart
# VOICE_CACHE_DIR=                # Default ~/.cache/librarian-voice
# Hosted speech for non-interview modes: opt in with the setting AND the key, or the session refuses.
# VOICE_STT_PROVIDER=local
# VOICE_TTS_PROVIDER=local
# OPENAI_API_KEY=
