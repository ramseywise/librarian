# Environment
.env
.env.local
.env.staging

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Obsidian workspace files — local UI state, not shared
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# DuckDB indexes (rebuild from data/wiki/)
*.duckdb
*.duckdb.wal

# macOS
.DS_Store

# VS Code
.vscode/

# Claude Code — machine-specific settings only
.claude/settings.local.json
# Ephemeral planning docs — canonical knowledge belongs in data/wiki/
.claude/docs/

# Node
node_modules/
**/node_modules/

# Vite cache artifacts
**/.vite/

# Raw ingest archive — personal/employer source material stays local-only.
# data/raw/ is where `cartographer --facts` derives session notes: verbatim prompts
# and project paths, regenerable from ~/.claude/projects. Never committed (#60).
# Consolidated from the old top-level raw/ in #96; the bare rule stays as a backstop
# so a stale writer recreating raw/ cannot leak source material into a commit.
raw/
data/raw/
data/db

# Cartographer fact table — rebuildable from data/raw/sessions + ~/.claude/projects
data/sessions.db
data/sessions.db.bak-*

# Cron run summary — per-run operational telemetry, overwritten every sweep. Relocated
# here from ~/.claude/docs/insights/ at #94, where the write recreated a directory that
# is deliberately absent. Counts and problem strings only, but this is a PUBLIC repo and
# problem strings carry local absolute paths: ignored, same as data/sessions.db.
data/cron/

# data/wiki/ is tracked — it is the repo's product, not rebuildable output.
# Only private pages stay local.
data/wiki/private/

# ...except the session log, which is both. `--cron` regenerates it from raw/sessions/,
# and since #60 gave it real topics its rows carry verbatim first prompts — the same
# content raw/ is ignored for, reaching a public repo through a tracked door. Untracked
# 2026-08-02; earlier revisions in history hold curated summaries only.
data/wiki/meta/session-log.md

# data/courses/ is tracked, the same way. data/courses/private/ is the local home of what must
# not be public: solutions to site problems, scratch code, interview prep. Served to the local
# UI, never indexed, exported or committed. `librarian wiki check` fails on a tracked file here.
data/courses/private/

# Generated presenter decks (`librarian present` default --out).
output/

# Runtime logs — cron output (cartographer, codemap) and MCP retrieval telemetry.
# logs/ at the repo root is the only log location; the cron scripts, both launchd
# plists, and librarian.retrieval all write here.
logs/*.log
logs/*.jsonl
logs/*.jsonl.[0-9]*
logs/*.err
logs/*.bak-*
# Course reviewer working data (findings log, eval results) and the signals report: personal history
logs/review/
logs/signals/

# Local caches (lesson embedding vectors for course concept linking)
.cache/
.import_linter_cache/

explain-skill/
second-brain-os/

# Telemetry from query history. metrics.jsonl and operations.jsonl stay tracked: they name
# no private page and no query.
data/telemetry/gaps.md
data/telemetry/asked.jsonl

# Regenerated by tests/e2e/test_screenshot.py
tests/screenshots/atlas.png

# built decks: rebuild with make slides; the yaml specs and images are tracked
data/courses/**/slides/*.pptx
data/courses/**/slides/*.pdf
data/courses/**/slides/lectures/*.pptx
data/courses/**/slides/lectures/*.pdf
data/courses/**/slides/.*.pdf.tmp
data/courses/**/slides/.preview/
data/courses/**/slides/lectures/.preview/

# Deployment state (indexes, caches, logs); path from LIBRARIAN_STATE_DIR
/var/

# Agent worktrees (Claude Code isolation)
.claude/worktrees/

# Personal Notion search terms for /ingest (copy queries.example.txt)
.claude/skills/ingest/queries.local.txt

# Personal codemap repo list (copy src/librarian/tools/codemap/repos.txt)
src/librarian/tools/codemap/repos.local.txt

# Prebuilt content mounted into the container (compose ./content); built locally, never tracked.
/content/

# ./librarian wrapper state (image in use, the one before it)
.ops/
