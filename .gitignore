# Environment
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Obsidian workspace files — local UI state, not shared
.obsidian/workspace.json
.obsidian/workspace-mobile.json
data/wiki/.obsidian/workspace.json
data/wiki/.obsidian/workspace-mobile.json

# DuckDB indexes (rebuild from wiki/)
*.duckdb
*.duckdb.wal

# Cron job logs
logs/*.log

# macOS
.DS_Store

# VS Code
.vscode/

# Claude Code — machine-specific settings only
.claude/settings.local.json
# Ephemeral planning docs — canonical knowledge belongs in wiki/
.claude/docs/

# Private wiki pages — company/project-specific content not committed to the public repo
data/wiki/private/
# Playground skills toolkit copies accidentally nested here — exclude until relocated
.claude/skills/skills/
.claude/skills/old/

# Node
node_modules/
**/node_modules/

# Vite cache artifacts
**/.vite/

# Raw ingest archive — personal/employer source material stays local-only
raw/
data/raw/
# Wiki output — compiled from raw/, large and rebuildable
data/wiki/
# wiki/ is tracked — it is the repo's product, not rebuildable output.
# Only private pages stay local.
wiki/private/
logs/*.jsonl

# Cartographer fact table — rebuildable from raw/sessions + ~/.claude/projects
data/sessions.db
logs/*.err

# Cartographer runtime logs (only .gitkeep is tracked)
tools/cartographer/logs/*
!tools/cartographer/logs/.gitkeep
