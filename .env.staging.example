# Staging stack: copy to .env.staging (gitignored) and fill in. `./librarian --stack staging <cmd>`
# reads this file instead of .env and runs as the compose project librarian-staging, so its
# Postgres, indexes and Caddy state are separate volumes from production's. docs/ops/staging.md.
#
# Staging must never share a secret, a database, a bucket prefix or an OAuth client with production.

# Host ports (production owns 80/443). Put a second host name in front, or use the localhost default.
LIBRARIAN_HTTP_PORT=8081
LIBRARIAN_HTTPS_PORT=8444
LIBRARIAN_DOMAIN=staging.librarian.example.com   # or localhost: Caddy's internal CA, run the e2e with --insecure
# LIBRARIAN_PUBLIC_URL=https://staging.librarian.example.com   # derived from the domain when unset

# Image under test, the same tag production will be promoted to (.github/workflows/promote.yml).
# LIBRARIAN_IMAGE=ghcr.io/OWNER/librarian:sha-abc1234

# Fresh secrets: openssl rand -hex 32
LIBRARIAN_API_TOKEN=
LIBRARIAN_SESSION_SECRET=
LIBRARIAN_METRICS_TOKEN=
POSTGRES_PASSWORD=

# A low-limit key, or a stub: staging chat spends real money.
ANTHROPIC_API_KEY=
LIBRARIAN_CHAT_DAILY_BUDGET_USD=2
LIBRARIAN_CHAT_USER_DAILY_BUDGET_USD=1

# Sign-in: a separate OAuth client whose callback is the staging URL, or none (the API token only).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Backups and content releases: leave unset. Staging has nothing worth restoring, and an unset
# LIBRARIAN_BACKUP_URL keeps the backup service off.
