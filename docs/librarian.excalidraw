   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What does not flow back: nothing a reader does changes the index, the ranking weights or a page. Feedback reaches content only through a person. The eval golden sets are not fed from live queries.",
   "originalText": "What does not flow back: nothing a reader does changes the index, the ranking weights or a page. Feedback reaches content only through a person. The eval golden sets are not fed from live queries.",
