   "locked": false,
   "text": "A citation carries a 16-char content hash;\ncitations.check() returns current, changed or missing,\nand a private page counts as missing.",
   "originalText": "A citation carries a 16-char content hash; citations.check() returns current, changed or missing, and a private page counts as missing.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
