   "versionNonce": 6039,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "An index file is never edited in place: a new corpus is\na new file, and the last 3 are kept.",
   "originalText": "An index file is never edited in place: a new corpus is a new file, and the last 3 are kept.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-1038",
   "lineHeight": 1.25,
   "autoResize": true
