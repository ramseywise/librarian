   "updated": 1,
   "link": null,
   "locked": false,
   "text": "score = 0.5 × (BM25 / max BM25) + 0.5 × cosine\n· TEXT_WEIGHT, SEMANTIC_WEIGHT at ranking.py:101-102,\n  \"measured 2026-11-05\"\n· LIKE rows use 1 − i/len in place of BM25",
   "originalText": "score = 0.5 × (BM25 / max BM25) + 0.5 × cosine\n· TEXT_WEIGHT, SEMANTIC_WEIGHT at ranking.py:101-102, \"measured 2026-11-05\"\n· LIKE rows use 1 − i/len in place of BM25",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-915",
   "lineHeight": 1.25,
