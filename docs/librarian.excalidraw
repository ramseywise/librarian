   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same inputs, same corpus_id: a rebuild of an unchanged\ncorpus is a no-op.",
   "originalText": "Same inputs, same corpus_id: a rebuild of an unchanged corpus is a no-op.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
