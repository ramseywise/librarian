   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "text-1039",
   "type": "text",
   "x": 5795,
   "y": 1556.75,
   "width": 429.0,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
