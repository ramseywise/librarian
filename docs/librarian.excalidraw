   "versionNonce": 6037,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The serving process opens the index read-only; nothing a\nrequest does can change it.",
   "originalText": "The serving process opens the index read-only; nothing a request does can change it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-1036",
   "lineHeight": 1.25,
   "autoResize": true
  },
